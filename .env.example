# Copy to .env (never commit .env!) and fill in your own keys. No spaces, no quotes.
OPENWEATHER_API_KEY=your_openweather_key
AQICN_TOKEN=your_aqicn_token
GROQ_API_KEY=your_groq_key

# Storage: Hugging Face Hub (feature store = private dataset repo, model registry = private model repo)
HF_TOKEN=your_huggingface_write_token
HF_DATASET_REPO=your-hf-username/agentweather-data
HF_MODEL_REPO=your-hf-username/agentweather-models

# Optional
GROQ_MODEL=openai/gpt-oss-20b
# STORE_BACKEND=local          # local files instead (development only)
# Hopsworks alternative (STORE_BACKEND=hopsworks):
# HOPSWORKS_API_KEY=
# HOPSWORKS_PROJECT=
# HOPSWORKS_HOST=
