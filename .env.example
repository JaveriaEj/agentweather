# Copy to .env (never commit .env!) and fill in your own keys.
OPENWEATHER_API_KEY=your_openweather_key
AQICN_TOKEN=your_aqicn_token
HOPSWORKS_API_KEY=your_hopsworks_api_key
HOPSWORKS_PROJECT=your_hopsworks_project_name
GROQ_API_KEY=your_groq_key
# Optional
# GROQ_MODEL=llama-3.3-70b-versatile
# STORE_BACKEND=local        # use local files instead of Hopsworks (development/tests only)
# HOPSWORKS_HOST=c.app.hopsworks.ai
